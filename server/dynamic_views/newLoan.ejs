<h1>Create a New Loan</h1>
<form action="/loans/create" method="POST">
  <label for="user_id">User:</label>
  <select name="user_id" required>
    <% users.forEach(user => { %>
      <option value="<%= user.id %>"><%= user.name %></option>
    <% }) %>
  </select><br>

  <label for="equipment_id">Equipment:</label>
  <select name="equipment_id" required>
    <% equipmentList.forEach(eq => { %>
      <option value="<%= eq.id %>"><%= eq.model %> (ID: <%= eq.id %>)</option>
    <% }) %>
  </select><br>

  <label for="date_out">Date Out:</label>
  <input type="date" name="date_out" required><br>

  <label for="date_in">Date In:</label>
  <input type="date" name="date_in"><br>

  <label for="location">Location:</label>
  <input type="text" name="location"><br>

  <label for="purpose">Purpose:</label>
  <input type="text" name="purpose" required><br>

  <label for="units">Units:</label>
  <input type="number" name="units"><br>

  <label for="comments">Comments:</label>
  <textarea name="comments"></textarea><br>

  <button type="submit">Submit</button>
</form>
